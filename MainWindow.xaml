<Window x:Class="week5_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:week5_3"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel Orientation="Vertical">
        <Label Content="First Name" Margin="0,15,0,0"/>
        <TextBox Name="txtFirstName" />
        <Label Content="Last Name" Margin="0,15,0,0"/>
        <TextBox Name="txtLastName" />
        <Button MaxWidth="200" Content="Enter" Foreground="Azure" Background="DarkOliveGreen" FontSize="25" Click="Button_Click"></Button>
    </StackPanel>


</Window>   
